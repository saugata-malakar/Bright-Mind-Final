# Application
APP_NAME=MediGuide AI
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-secret-key-here-change-in-production

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# Database
DATABASE_URL=postgresql://mediguide:mediguide123@localhost:5432/mediguide
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=0

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# Ollama / Gemma 4
OLLAMA_URL=http://localhost:11434
GEMMA_MODEL=gemma4:9b
GEMMA_TEMPERATURE=0.7
GEMMA_MAX_TOKENS=2048

# ChromaDB
CHROMA_URL=http://localhost:8001
CHROMA_COLLECTION=medical_knowledge

# Authentication
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# File Upload
MAX_UPLOAD_SIZE=10485760  # 10MB
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,dcm

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Monitoring
SENTRY_DSN=
PROMETHEUS_ENABLED=true

# Medical Knowledge Base
MEDICAL_KB_PATH=./medical-kb
AUTO_SYNC_KB=true

# Email (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@mediguide.ai

# Cloud Storage (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=mediguide-uploads

# Feature Flags
ENABLE_IMAGE_ANALYSIS=true
ENABLE_VOICE_INPUT=false
ENABLE_TELEMEDICINE=false
ENABLE_ANALYTICS=true
