# Application
APP_NAME=CogniCore
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production

# Database
DATABASE_URL=postgresql://cognicore:cognicore123@postgres:5432/cognicore
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=0

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=50

# Ollama / Gemma 4
OLLAMA_URL=http://ollama:11434
GEMMA_MODEL=gemma4:9b
GEMMA_TEMPERATURE=0.7
GEMMA_MAX_TOKENS=2048

# ChromaDB
CHROMA_URL=http://chromadb:8000
CHROMA_COLLECTION=educational_knowledge

# Authentication
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Educational Knowledge Base
EDUCATIONAL_KB_PATH=./educational-kb
AUTO_SYNC_KB=True
